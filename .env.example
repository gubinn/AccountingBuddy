# Email
EMAIL_HOST=imap.163.com
EMAIL_PORT=993
EMAIL_USER=your_email@163.com
EMAIL_PASSWORD=your_app_password

# API
API_BASE_URL=http://127.0.0.1:6060/api/v1
API_KEY=your-api-key

# Telegram chat intake (optional; only needed for intake_daemon.py)
# Create a bot with @BotFather, then paste the token here.
TELEGRAM_BOT_TOKEN=
# Comma-separated chat ids allowed to record transactions. Send /start to the
# bot and read the rejected chat id from the intake log on first setup.
TELEGRAM_ALLOWED_CHAT_IDS=
